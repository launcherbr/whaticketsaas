# libzapitu-rf depends on "libsignal" (github:renatoiub/libsignal-node),
# a fork that is not published on the npm registry. Newer npm versions
# (11.5+) block git dependencies by default in some environments via the
# "allow-git" setting; this re-enables it just for this project instead of
# loosening the restriction globally on the machine.
allow-git=all
